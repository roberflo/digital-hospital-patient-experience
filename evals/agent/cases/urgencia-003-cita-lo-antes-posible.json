    "match": [
      "\\b0?9[:.]00\\b|\\b9\\s*(am|a\\.\\s?m\\.)",
      "\\b{opendom+1}\\s+de\\s+\\w+",
      "¿Es una emergencia\\?"
    ],
    "noMatch": [
      "(?i)\\b(qued[oó]|est[aá]|ha sido|fue)\\s+(ya\\s+)?(agendad|reservad|confirmad)[ao]\\b",
      "¿Es una emergencia\\?[\\s\\S]*¿Es una emergencia\\?"
    ]
  }
}