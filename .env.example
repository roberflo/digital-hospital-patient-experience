# Copy this file or run python3 scripts/init-dev.py. Never commit .env.
POSTGRES_PASSWORD=
PHONE_HASH_KEY=
AUTH_SECRET=
# Production is the safe default. scripts/init-dev.py opts into Development (synthetic demo data).
# There is no local login in any environment: Hospital's Keycloak realm is the only issuer.
ASPNETCORE_ENVIRONMENT=Production
INITIALIZE_DATABASE=false
NEXTAUTH_URL=https://recepcion.example.com
FRONTEND_URL=https://recepcion.example.com
KEYCLOAK_ISSUER=https://identity.example.com/realms/hospital
KEYCLOAK_CLIENT_ID=recepcion-web
KEYCLOAK_CLIENT_SECRET=
Auth__Authority=https://identity.example.com/realms/hospital
Auth__Audience=hospital-api
BOOTSTRAP_TENANT_ID=
BOOTSTRAP_TENANT_NAME=
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_URL=https://api-recepcion.example.com/webhooks/kapso
KAPSO_WEBHOOK_SECRET=
KAPSO_MANUAL_SEND_ENABLED=false
# Marks the patient's message as read and shows «escribiendo…» while the agent prepares its answer.
KAPSO_TYPING_INDICATOR=false
SEND_ENABLED=false
# Separate gate for approved appointment reminder templates.
REMINDERS_SEND_ENABLED=false
NVIDIA_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional second provider. When both are set, a failed NIM call (network, timeout, 429, 5xx) is
# repeated once on OpenAI; tools are never replayed. Patient conversation text then reaches OpenAI:
# enable it only after the hospital has approved that processor.
OPENAI_API_KEY=
# Chosen with the evals (docs/reception-agent.md): gpt-6-luna is the cheapest that passes them. It only takes tools in
# Chat Completions with the reasoning effort stated as none; other models need another value or none at all.
# To grade another: AGENT_EVAL_PROVIDER=openai AGENT_EVAL_REASONING=<effort> AGENT_EVAL_SPACING=0.3 scripts/eval-agent.sh <model>
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
# Only for a model that passes the evals without reasoning; measured with nemotron-3-super it drops 102/107 to 82/107.
AI_DISABLE_THINKING=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api-recepcion.example.com/oauth/google/callback
# Hospital connection, once per installation. Every hospital then connects by signing in: its
# service account is `recepcion-service-<tenant>` in Hospital's realm (created by Hospital's
# keycloak-config job) and all of them share this secret (= KC_RECEPCION_SERVICE_CLIENT_SECRET there).
HOSPITAL_API_URL=https://hospital-api.example.com
HOSPITAL_SERVICE_CLIENT_SECRET=
# Only prescription delivery is authorized per hospital, explicitly:
# Hospital__Tenants__YOUR-TENANT-GUID__UseReceptionBridge=true
# Hospital__Tenants__YOUR-TENANT-GUID__AllowClinicalDelivery=true
# Kapso__Tenants__YOUR-TENANT-GUID__CustomerId=

# Optional server-only Keycloak backchannel URL (Docker network). Public issuer remains unchanged.
# Local: scripts/connect-hospital-local.py fills every Keycloak value from the Hospital checkout.
KEYCLOAK_INTERNAL_ISSUER=

# Trusted Hospital API origins (comma-separated) and the public Hospital UI.
HOSPITAL_ALLOWED_API_ORIGINS=https://hospital-api.example.com
HOSPITAL_PUBLIC_URL=https://hospital.example.com
# A hospital's Administrador opens its space by signing in. Set false to require BOOTSTRAP_TENANT_ID.
HOSPITAL_SELF_ONBOARDING=true
