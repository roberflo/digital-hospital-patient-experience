+using Hospital.Application.Abstractions;
+using Hospital.Application.Abstractions.Auditing;
+using Hospital.Scheduling.Domain;
+using Hospital.SharedKernel;
+using MediatR;
+
+namespace Hospital.Scheduling.Application.Queries;
+
+public sealed record GetPatientAgendaQuery(PatientId PatientId, DateOnly From, DateOnly To)
+    : IRequest<Result<PatientAgendaResult>>, IPatientScopedRequest, IPatientAccessDescriptor
+{
+    public override string ToString() => nameof(GetPatientAgendaQuery);
+    public string ResourceType => PatientResourceTypes.AgendaDayView;
+    public AuditAction Action => AuditAction.Read;
+    /// <summary>This read names a set of appointments for one patient, never a single artifact (ADR-0027).</summary>
+    public bool NamesNoSingleArtifact => true;
+}
+
+public sealed record PatientAgendaResult(DateOnly From, DateOnly To, IReadOnlyList<PatientAgendaRow> Rows);
+public sealed record PatientAgendaRow(Guid AppointmentId, Guid ClinicianId, string ClinicianName,
+    DateTimeOffset ScheduledStart, int DurationMinutes, AppointmentDisplayState Status);
