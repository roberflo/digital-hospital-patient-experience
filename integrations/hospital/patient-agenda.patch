+using FluentAssertions;
+using Hospital.Application.Abstractions;
+using Hospital.Scheduling.Application.Queries;
+using Hospital.Scheduling.Domain;
+using Hospital.SharedKernel;
+
+namespace Hospital.Scheduling.Application.Tests;
+
+public sealed class PatientAgendaQueryTests
+{
+    private static readonly DateTimeOffset Now = DateTimeOffset.Parse("2026-10-02T18:00:00Z");
+    private static readonly TimeZoneInfo Zone = TimeZoneInfo.FindSystemTimeZoneById("America/El_Salvador");
+
+    [Theory]
+    [InlineData("2026-10-03", "2026-10-02", "scheduling.range_bounds_out_of_order")]
+    [InlineData("2026-10-01", "2026-11-01", "scheduling.range_exceeds_horizon")]
+    public async Task Invalid_ranges_fail_before_names_are_read(string from, string to, string code)
+    {
+        var names = new FakeActorDisplayNameReader();
+        var handler = new GetPatientAgendaQueryHandler(new FakeAppointmentRepository(),
+            new FixedClinicCalendar(Zone), new FixedClock(Now), names);
+        var result = await handler.Handle(new(new PatientId(Guid.NewGuid()), DateOnly.Parse(from), DateOnly.Parse(to)), default);
+        result.IsSuccess.Should().BeFalse();
+        result.Error!.Code.Should().Be(code);
+        names.CallCount.Should().Be(0);
+    }
+
+    [Fact]
+    public async Task Patient_range_uses_clinic_day_and_preserves_cancellation_and_current_state()
+    {
+        var patient = new PatientId(Guid.NewGuid());
+        Appointment Make(PatientId owner, string at) => Appointment.Schedule(new(Guid.NewGuid()),
+            new TenantId(Guid.NewGuid()), owner, Guid.NewGuid(), DateTimeOffset.Parse(at), 30,
+            VisitKind.FollowUp, Guid.NewGuid(), Now.AddDays(-10));
+        var past = Make(patient, "2026-10-02T01:00:00Z"); // 19h on October 1 in the clinic.
+        var cancelled = Make(patient, "2026-10-02T02:00:00Z");
+        cancelled.Cancel(Guid.NewGuid(), Now.AddDays(-2), CancellationReason.PatientRequest, true);
+        var future = Make(patient, "2026-10-04T14:00:00Z");
+        var other = Make(new PatientId(Guid.NewGuid()), "2026-10-02T01:00:00Z");
+        var repo = new FakeAppointmentRepository { ScheduledForDay = [future, other, cancelled, past] };
+        var handler = new GetPatientAgendaQueryHandler(repo, new FixedClinicCalendar(Zone),
+            new FixedClock(Now), new FakeActorDisplayNameReader());
+        var result = await handler.Handle(new(patient, new(2026, 10, 1), new(2026, 10, 1)), default);
+        result.IsSuccess.Should().BeTrue();
+        result.Value.Rows.Select(x => x.AppointmentId).Should().Equal(past.Id.Value, cancelled.Id.Value);
+        result.Value.Rows[0].ScheduledStart.Offset.Should().Be(TimeSpan.FromHours(-6));
+        result.Value.Rows[0].ScheduledStart.Day.Should().Be(1);
+        result.Value.Rows[0].Status.Should().Be(AppointmentDisplayState.NotRecorded);
+        result.Value.Rows[1].Status.Should().Be(AppointmentDisplayState.CancelledByPatient);
+    }
+
+    [Fact]
+    public void Query_diagnostics_never_contain_patient_identifiers()
+    {
+        var patient = new PatientId(Guid.NewGuid());
+        new GetPatientAgendaQuery(patient, new(2026, 10, 1), new(2026, 10, 2))
+            .ToString().Should().NotContain(patient.Value.ToString());
+    }
+
+    [Fact]
+    public async Task Unrepresentable_exclusive_day_end_is_a_validation_error()
+    {
+        var handler = new GetPatientAgendaQueryHandler(new FakeAppointmentRepository(),
+            new FixedClinicCalendar(Zone), new FixedClock(Now), new FakeActorDisplayNameReader());
+        var result = await handler.Handle(new(new(Guid.NewGuid()), DateOnly.MaxValue, DateOnly.MaxValue), default);
+        result.IsSuccess.Should().BeFalse();
+        result.Error!.Code.Should().Be("scheduling.invalid_clinical_day");
+    }
+
+    [Fact]
+    public void Patient_list_uses_existing_guard_and_artifact_set_audit_contract()
+    {
+        var q = new GetPatientAgendaQuery(new(Guid.NewGuid()), new(2026, 10, 1), new(2026, 10, 2));
+        q.Should().BeAssignableTo<IPatientScopedRequest>();
+        IPatientAccessDescriptor d = q;
+        d.NamesNoSingleArtifact.Should().BeTrue();
+        d.ResourceId.Should().BeNull();
+        d.ResourceType.Should().Be(PatientResourceTypes.AgendaDayView);
+    }
+}
