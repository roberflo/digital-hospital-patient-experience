 {
+    [HttpGet("patients/{patientId:guid}")]
+    [ProducesResponseType<PatientAgendaResponse>(StatusCodes.Status200OK)]
+    [ProducesResponseType<ProblemDetails>(StatusCodes.Status400BadRequest)]
+    [ProducesResponseType<ProblemDetails>(StatusCodes.Status404NotFound)]
+    public async Task<ActionResult<PatientAgendaResponse>> GetPatientAgenda(
+        Guid patientId, [FromQuery] string? from, [FromQuery] string? to, CancellationToken ct)
+    {
+        if (!DateOnly.TryParseExact(from, "yyyy-MM-dd", out var fromDay)
+            || !DateOnly.TryParseExact(to, "yyyy-MM-dd", out var toDay))
+            return Result<PatientAgendaResponse>.Failure(
+                Error.Validation("scheduling.invalid_clinical_day", "from/to")).ToActionResult(this);
+        return (await sender.Send(new GetPatientAgendaQuery(new PatientId(patientId), fromDay, toDay), ct))
+            .ToBoundaryActionResult(this, PatientAgendaResponse.FromResult);
+    }
+
