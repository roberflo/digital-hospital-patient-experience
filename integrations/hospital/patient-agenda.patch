+using FluentAssertions;
+using Hospital.Scheduling.Domain;
+using Hospital.Scheduling.Infrastructure.Persistence;
+using Hospital.Scheduling.Infrastructure.Repositories;
+using Hospital.SharedKernel;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.DependencyInjection;
+
+namespace Hospital.Scheduling.Infrastructure.Tests;
+
+public sealed class PatientAgendaRepositoryTests
+{
+    [Fact]
+    public async Task Actual_repository_returns_only_requested_patient_tenant_and_window()
+    {
+        // Keep this model-only protector out of other tests' cached EF model/converters.
+        using var provider = new ServiceCollection().AddEntityFrameworkInMemoryDatabase().BuildServiceProvider();
+        var options = new DbContextOptionsBuilder<SchedulingDbContext>()
+            .UseInternalServiceProvider(provider)
+            .UseInMemoryDatabase(Guid.NewGuid().ToString()).Options;
+        var tenant = new TenantId(Guid.NewGuid());
+        var patient = new PatientId(Guid.NewGuid());
+        var start = DateTimeOffset.Parse("2026-10-02T14:00:00Z");
+        await using var db = new SchedulingDbContext(options,
+            new FixedSchedulingTenantScope(tenant), new NeverInvokedPhiProtector());
+        Appointment Make(TenantId t, PatientId p, DateTimeOffset at) => Appointment.Schedule(
+            new(Guid.NewGuid()), t, p, Guid.NewGuid(), at, 30, VisitKind.FollowUp, Guid.NewGuid(), start.AddDays(-1));
+        var expected = Make(tenant, patient, start);
+        db.Appointments.AddRange(expected,
+            Make(tenant, new(Guid.NewGuid()), start), Make(tenant, patient, start.AddDays(1)));
+        await db.SaveChangesAsync();
+        var otherTenant = new TenantId(Guid.NewGuid());
+        await using (var otherDb = new SchedulingDbContext(options,
+            new FixedSchedulingTenantScope(otherTenant), new NeverInvokedPhiProtector()))
+        {
+            otherDb.Appointments.Add(Make(otherTenant, patient, start));
+            await otherDb.SaveChangesAsync();
+        }
+        db.ChangeTracker.Clear();
+        var rows = await new AppointmentRepository(db).GetPatientScheduledForDaysAsync(patient,
+            [(start, start.AddDays(1))], default);
+        rows.Should().ContainSingle().Which.Id.Should().Be(expected.Id);
+    }
+}
