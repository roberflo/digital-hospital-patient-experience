+using Hospital.Application.Abstractions;
+using Hospital.Application.Abstractions.Clinic;
+using Hospital.Application.Abstractions.Professionals;
+using Hospital.Scheduling.Application.Ports;
+using Hospital.SharedKernel;
+using MediatR;
+
+namespace Hospital.Scheduling.Application.Queries;
+
+public sealed class GetPatientAgendaQueryHandler(IAppointmentRepository repository,
+    IClinicCalendar calendar, IClock clock, IActorDisplayNameReader actorNames)
+    : IRequestHandler<GetPatientAgendaQuery, Result<PatientAgendaResult>>
+{
+    public async Task<Result<PatientAgendaResult>> Handle(GetPatientAgendaQuery request, CancellationToken ct)
+    {
+        if (request.From == DateOnly.MinValue || request.To == DateOnly.MaxValue)
+            return Error.Validation("scheduling.invalid_clinical_day", "from/to");
+        if (request.To < request.From)
+            return Error.Validation("scheduling.range_bounds_out_of_order", "to");
+        var days = request.To.DayNumber - request.From.DayNumber + 1;
+        if (days > GetRangeViewQuery.MaxDaysPerQuery)
+            return Error.Validation("scheduling.range_exceeds_horizon", "to");
+
+        var zone = await calendar.ResolveTimeZoneAsync(ct);
+        var windows = Enumerable.Range(0, days)
+            .Select(offset => ClinicalDay.UtcRangeFor(request.From.AddDays(offset), zone)).ToArray();
+        // The repository narrows in SQL, before names or appointment events are materialized.
+        var appointments = await repository.GetPatientScheduledForDaysAsync(request.PatientId, windows, ct);
+        var names = await actorNames.GetDisplayNamesAsync(
+            appointments.Select(a => new ActorId(a.IntendedClinicianId)).Distinct().ToArray(), ct);
+        var opened = ClinicalDayClosure.CurrentDayOpenedAtUtc(clock.UtcNow, zone);
+        return new PatientAgendaResult(request.From, request.To,
+            appointments.OrderBy(a => a.StartUtc).ThenBy(a => a.Id.Value).Select(a => new PatientAgendaRow(
+                a.Id.Value, a.IntendedClinicianId,
+                names.GetValueOrDefault(new ActorId(a.IntendedClinicianId), string.Empty),
+                TimeZoneInfo.ConvertTime(a.StartUtc, zone), a.DurationMinutes,
+                a.ComputeDisplayState(opened))).ToArray());
+    }
+}
