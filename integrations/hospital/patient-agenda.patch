+using System.Reflection;
+using FluentAssertions;
+using Hospital.Scheduling.Endpoints;
+using Hospital.Scheduling.Endpoints.Contracts;
+using Hospital.Scheduling.Application.Queries;
+using Hospital.Scheduling.Domain;
+using Microsoft.AspNetCore.Authorization;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc;
+
+namespace Hospital.Scheduling.Endpoints.Tests;
+
+public sealed class PatientAgendaContractTests
+{
+    [Fact]
+    public void Wire_contains_only_appointment_details_and_preserves_the_clinic_offset()
+    {
+        var result = new PatientAgendaResult(new(2026, 10, 1), new(2026, 10, 2),
+            [new(Guid.NewGuid(), Guid.NewGuid(), "Doctora Sintética",
+                DateTimeOffset.Parse("2026-10-01T19:00:00-06:00"), 30, AppointmentDisplayState.CancelledByPatient)]);
+        var dto = PatientAgendaResponse.FromResult(result);
+        using var json = JsonDocument.Parse(JsonSerializer.Serialize(dto, new JsonSerializerOptions(JsonSerializerDefaults.Web)));
+        json.RootElement.EnumerateObject().Select(p => p.Name).Should().BeEquivalentTo("from", "to", "rows");
+        json.RootElement.GetProperty("rows")[0].EnumerateObject().Select(p => p.Name).Should().BeEquivalentTo(
+            "appointmentId", "clinicianId", "clinicianName", "scheduledStart", "durationMinutes", "status");
+        dto.Rows.Single().Status.Should().Be("cancelled-by-patient");
+        dto.Rows.Single().ScheduledStart.Offset.Should().Be(TimeSpan.FromHours(-6));
+    }
+
+    [Fact]
+    public void Patient_agenda_is_an_explicit_authenticated_read()
+    {
+        typeof(AgendaController).GetCustomAttributes<AuthorizeAttribute>(inherit: true).Should().NotBeEmpty();
+        typeof(AgendaController).GetCustomAttributes<AllowAnonymousAttribute>(inherit: true).Should().BeEmpty();
+        typeof(AgendaController).GetMethods()
+            .SelectMany(m => m.GetCustomAttributes<HttpGetAttribute>())
+            .Should().Contain(a => a.Template == "patients/{patientId:guid}",
+                "Recepción must read one patient's appointments without enumerating the hospital");
+    }
+}
