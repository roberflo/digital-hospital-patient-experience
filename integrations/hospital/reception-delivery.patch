+
+namespace Hospital.Api.IntegrationTests.Reception;
+
+public sealed class ReceptionDeliveryTests
+{
+    [Theory]
+    [InlineData("disabled")]
+    [InlineData("wrong-client")]
+    [InlineData("wrong-subject")]
+    [InlineData("wrong-tenant")]
+    [InlineData("missing-role")]
+    [InlineData("malformed-role")]
+    [InlineData("nonobject-role")]
+    [InlineData("anonymous")]
+    public async Task Rejects_untrusted_service_before_reading_patient(string variant)
+    {
+        var fixture = new Fixture();
+        var claims = fixture.Principal(variant);
+        if (variant == "disabled") fixture.Configuration[fixture.Prefix + "Enabled"] = "false";
+        await Assert.ThrowsAsync<ReceptionDeliveryDeniedException>(() => fixture.Service.ReadAsync(
+            claims, fixture.Rx.Id.Value, new() { Phone = Fixture.Phone }, default));
+        Assert.Equal(0, fixture.OwnershipReads);
+        Assert.IsType<AuditSubject.None>(Assert.Single(fixture.Audit).Subject);
+        Assert.Equal(0, fixture.PatientReads);
+        Assert.Equal(0, fixture.PrescriptionReads);
+        Assert.Single(fixture.Audit);
+        Assert.Equal(AuditOutcome.Denied, fixture.Audit[0].Outcome);
+    }
+
+    [Theory]
+    [InlineData("+50370000002")]
+    [InlineData("70000001")]
+    [InlineData("")]
+    public async Task Rejects_phone_mismatch_without_decrypting_prescription(string phone)
+    {
+        var f = new Fixture();
+        await Assert.ThrowsAsync<ReceptionDeliveryDeniedException>(() => f.Service.ReadAsync(
+            f.Principal(), f.Rx.Id.Value, new() { Phone = phone }, default));
+        Assert.Equal(0, f.PrescriptionReads);
+        Assert.Equal(AuditOutcome.Denied, Assert.Single(f.Audit).Outcome);
+    }
+
+    [Fact]
+    public async Task Rejects_patient_filtered_out_by_tenant()
+    {
+        var f = new Fixture { PatientMissing = true };
+        await Assert.ThrowsAsync<ReceptionDeliveryDeniedException>(() => f.Read());
+        Assert.Equal(0, f.PrescriptionReads);
+    }
+
+    [Fact]
+    public async Task Rejects_foreign_prescription_before_decryption()
+    {
+        var f = new Fixture { ForeignPrescriptionOwner = true };
+        await Assert.ThrowsAsync<ReceptionDeliveryDeniedException>(() => f.Read());
+        Assert.Equal(0, f.PrescriptionReads);
+        Assert.Equal(AuditOutcome.Denied, Assert.Single(f.Audit).Outcome);
+    }
+
+    [Fact]
+    public async Task Missing_tenant_scoped_owner_is_denied_without_patient_or_decryption()
+    {
+        var f = new Fixture { OwnerMissing = true };
+        await Assert.ThrowsAsync<ReceptionDeliveryDeniedException>(() => f.Read());
+        Assert.Equal(0, f.PatientReads);
+        Assert.Equal(0, f.PrescriptionReads);
+        Assert.IsType<AuditSubject.None>(Assert.Single(f.Audit).Subject);
+    }
+
+    [Fact]
+    public async Task Resolved_owner_is_the_audit_subject_even_when_another_patient_has_the_same_phone()
+    {
+        // The phone is identical; an inconsistent patient store must still not substitute identity.
+        var f = new Fixture { ForeignPrescriptionOwner = true };
+        await Assert.ThrowsAsync<ReceptionDeliveryDeniedException>(() => f.Read());
+        Assert.Equal(0, f.PrescriptionReads);
+        Assert.Equal(SyntheticCast.DorisZaldivar,
+            Assert.IsType<AuditSubject.Patient>(Assert.Single(f.Audit).Subject).PatientId);
+    }
+
+    [Fact]
+    public async Task Missing_signer_profile_prevents_pdf_rendering()
+    {
+        var f = new Fixture { ProfileMissing = true };
+        await Assert.ThrowsAsync<ReceptionDeliveryDeniedException>(() => f.Service.PdfAsync(
+            f.Principal(), f.Rx.Id.Value, new() { Phone = Fixture.Phone }, default));
+        Assert.Equal(0, f.RenderCalls);
+        Assert.Equal(AuditOutcome.Denied, Assert.Single(f.Audit).Outcome);
+    }
+
+    [Fact]
+    public async Task Rejects_draft()
+    {
+        var f = new Fixture { Rx = SyntheticPrescriptions.Draft() };
+        await Assert.ThrowsAsync<ReceptionDeliveryDeniedException>(() => f.Read());
+        Assert.Equal(AuditOutcome.Denied, Assert.Single(f.Audit).Outcome);
+    }
+
+    [Fact]
+    public async Task Returns_only_signed_prescription_and_audits_service_export_with_hash()
+    {
+        var f = new Fixture();
+        var result = JsonSerializer.SerializeToElement(await f.Read(), JsonSerializerOptions.Web);
+        Assert.Equal(f.Patient.Id.Value, result.GetProperty("patientId").GetGuid());
+        Assert.Equal("signed", result.GetProperty("state").GetString());
+        Assert.Equal(2, result.GetProperty("lines").GetArrayLength());
+        var entry = Assert.Single(f.Audit);
+        Assert.IsType<AuditActor.Service>(entry.Actor);
+        Assert.Equal(AuditAction.Export, entry.Action);
+        Assert.Equal(AuditOutcome.Allowed, entry.Outcome);
+        Assert.Equal(64, entry.ExportedContentSha256!.Length);
+        Assert.DoesNotContain(Fixture.Phone, entry.ToString());
+        Assert.DoesNotContain("Sinteticilina", entry.ToString());
+        Assert.DoesNotContain(Fixture.Phone, new ReceptionDeliveryRequest { Phone = Fixture.Phone }.ToString());
+    }
+
+    [Fact]
+    public async Task Audit_failure_prevents_delivery()
+    {
+        var f = new Fixture { AuditFails = true };
+        await Assert.ThrowsAsync<IOException>(() => f.Read());
+    }
+
+    [Fact]
+    public async Task Rejects_cancelled_prescription()
+    {
+        var f = new Fixture();
