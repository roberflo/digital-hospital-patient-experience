+using System.IdentityModel.Tokens.Jwt;
+using System.Net;
+using System.Net.Http.Headers;
+using System.Net.Http.Json;
+using System.Text;
+using Hospital.Api.IntegrationTests.TestSupport;
+using Hospital.Application.Abstractions.Reception;
+using Microsoft.AspNetCore.Authentication.JwtBearer;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.DependencyInjection.Extensions;
+using Microsoft.IdentityModel.Protocols;
+using Microsoft.IdentityModel.Protocols.OpenIdConnect;
+using Microsoft.IdentityModel.Tokens;
+
+namespace Hospital.Api.IntegrationTests.Reception;
+
+/// <summary>Real API routing, authorization and JWT signature/audience/issuer/lifetime
+/// validation, with synthetic signing keys and the real delivery service over fake stores.</summary>
+public sealed class ReceptionDeliveryHttpTests
+{
+    [Theory]
+    [InlineData("anonymous")]
+    [InlineData("invalid-signature")]
+    [InlineData("wrong-audience")]
+    [InlineData("wrong-issuer")]
+    [InlineData("expired")]
+    public async Task Jwt_failures_never_reach_the_delivery_service(string variant)
+    {
+        var f = new ReceptionDeliveryTests.Fixture();
+        using var factory = new DeliveryFactory(f);
+        using var client = factory.CreateClient();
+        if (variant != "anonymous") client.DefaultRequestHeaders.Authorization = new("Bearer", Token(f, variant));
+        var response = await client.PostAsJsonAsync(Path(f), new { phone = ReceptionDeliveryTests.Fixture.Phone });
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+        Assert.Empty(f.Audit);
+        Assert.Equal(0, f.PatientReads);
+    }
+
+    [Theory]
+    [InlineData("wrong-client")]
+    [InlineData("wrong-subject")]
+    [InlineData("wrong-tenant")]
+    [InlineData("missing-role")]
+    public async Task Valid_signature_does_not_grant_delivery_to_other_identities(string variant)
+    {
+        var f = new ReceptionDeliveryTests.Fixture();
+        using var factory = new DeliveryFactory(f);
+        using var client = factory.CreateClient();
+        client.DefaultRequestHeaders.Authorization = new("Bearer", Token(f, variant));
+        var response = await client.PostAsJsonAsync(Path(f), new { phone = ReceptionDeliveryTests.Fixture.Phone });
+        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
+        Assert.Equal(0, f.PrescriptionReads);
+        Assert.Single(f.Audit);
+    }
+
+    [Fact]
+    public async Task Authorized_json_is_typed_private_and_contains_only_the_requested_prescription()
+    {
+        var f = new ReceptionDeliveryTests.Fixture();
+        using var factory = new DeliveryFactory(f);
+        using var client = factory.CreateClient();
+        client.DefaultRequestHeaders.Authorization = new("Bearer", Token(f));
+        var response = await client.PostAsJsonAsync(Path(f), new { phone = ReceptionDeliveryTests.Fixture.Phone });
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.True(response.Headers.CacheControl?.NoStore);
+        var body = await response.Content.ReadFromJsonAsync<ReceptionPrescriptionDetail>();
+        Assert.Equal(f.Patient.Id.Value, body!.PatientId);
+        Assert.Equal(f.Rx.Id.Value, body.PrescriptionId);
+        Assert.Equal(2, body.Lines.Count);
+    }
+
+    [Fact]
+    public async Task Pdf_route_streams_private_pdf_after_authorization()
+    {
+        var f = new ReceptionDeliveryTests.Fixture();
+        using var factory = new DeliveryFactory(f);
+        using var client = factory.CreateClient();
+        client.DefaultRequestHeaders.Authorization = new("Bearer", Token(f));
+        var response = await client.PostAsJsonAsync(Path(f) + "/pdf", new { phone = ReceptionDeliveryTests.Fixture.Phone });
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal("application/pdf", response.Content.Headers.ContentType!.MediaType);
+        Assert.True(response.Headers.CacheControl?.NoStore);
+        Assert.Equal("%PDF-synthetic", await response.Content.ReadAsStringAsync());
+    }
+
+    [Fact]
+    public async Task Changed_phone_is_uniformly_unavailable()
+    {
+        var f = new ReceptionDeliveryTests.Fixture();
+        using var factory = new DeliveryFactory(f);
+        using var client = factory.CreateClient();
+        client.DefaultRequestHeaders.Authorization = new("Bearer", Token(f));
+        var response = await client.PostAsJsonAsync(Path(f), new { phone = "+50370000002" });
+        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
+        Assert.Equal(0, f.PrescriptionReads);
+    }
+
+    private const string Issuer = "https://synthetic-reception.example/realm";
+    private static readonly SymmetricSecurityKey Key = new(Encoding.UTF8.GetBytes(new string('s', 64)));
+    private static string Path(ReceptionDeliveryTests.Fixture f) => $"/v1/reception/prescriptions/{f.Rx.Id.Value}";
+
+    private static string Token(ReceptionDeliveryTests.Fixture f, string variant = "")
+    {
+        var token = new JwtSecurityToken(variant == "wrong-issuer" ? "https://other.example" : Issuer,
+            variant == "wrong-audience" ? "different-api" : "hospital-api", f.Principal(variant).Claims,
+            notBefore: DateTime.UtcNow.AddMinutes(-10),
+            expires: variant == "expired" ? DateTime.UtcNow.AddMinutes(-1) : DateTime.UtcNow.AddMinutes(5),
+            signingCredentials: new SigningCredentials(variant == "invalid-signature"
+                ? new SymmetricSecurityKey(Encoding.UTF8.GetBytes(new string('x', 64))) : Key, SecurityAlgorithms.HmacSha256));
+        return new JwtSecurityTokenHandler().WriteToken(token);
+    }
+
+    private sealed class DeliveryFactory(ReceptionDeliveryTests.Fixture fixture) : HospitalApiFactory
+    {
+        protected override void ConfigureWebHost(IWebHostBuilder builder)
+        {
+            base.ConfigureWebHost(builder);
+            builder.ConfigureServices(services =>
+            {
+                services.Replace(ServiceDescriptor.Singleton<IReceptionDeliveryService>(fixture.Service));
+                services.PostConfigure<JwtBearerOptions>(JwtBearerDefaults.AuthenticationScheme, options =>
+                {
+                    options.ConfigurationManager = new StaticConfigurationManager<OpenIdConnectConfiguration>(
+                        new OpenIdConnectConfiguration { Issuer = Issuer, SigningKeys = { Key } });
+                    options.TokenValidationParameters = new TokenValidationParameters
+                    {
+                        ValidateIssuer = true, ValidIssuer = Issuer, ValidateAudience = true, ValidAudience = "hospital-api",
+                        ValidateLifetime = true, ClockSkew = TimeSpan.Zero, ValidateIssuerSigningKey = true,
+                        IssuerSigningKey = Key, ValidAlgorithms = [SecurityAlgorithms.HmacSha256]
+                    };
+                });
+            });
+        }
+    }
+}
