+            PaperDeliveryState.Unknown, SyntheticPrescriptions.CancelledAt);
+        await Assert.ThrowsAsync<ReceptionDeliveryDeniedException>(() => f.Read());
+        Assert.Equal(AuditOutcome.Denied, Assert.Single(f.Audit).Outcome);
+    }
+
+    [Fact]
+    public async Task Rejects_entered_in_error_prescription()
+    {
+        var f = new Fixture();
+        f.Rx.DeclareEnteredInError(ArtifactStatusReasonCode.WrongPatient, "Destinatario sintético incorrecto",
+            SyntheticCast.CardozaSigning(), SyntheticCast.DorisZaldivar, PaperDeliveryState.Unknown,
+            SyntheticPrescriptions.VoidedAt);
+        await Assert.ThrowsAsync<ReceptionDeliveryDeniedException>(() => f.Read());
+        Assert.Equal(AuditOutcome.Denied, Assert.Single(f.Audit).Outcome);
+    }
+
+    [Fact]
+    public async Task Pdf_reuses_hospital_mapper_and_audits_before_returning_bytes()
+    {
+        var f = new Fixture();
+        var bytes = await f.Service.PdfAsync(f.Principal(), f.Rx.Id.Value,
+            new() { Phone = Fixture.Phone }, default);
+        Assert.Equal("%PDF-synthetic", System.Text.Encoding.ASCII.GetString(bytes));
+        Assert.Equal(AuditOutcome.Allowed, Assert.Single(f.Audit).Outcome);
+        Assert.Equal(64, f.Audit[0].ExportedContentSha256!.Length);
+    }
+
+    [Fact]
+    public async Task Invalid_frozen_licence_prevents_pdf()
+    {
+        var f = new Fixture { LicenseRejected = true };
+        await Assert.ThrowsAsync<ReceptionDeliveryDeniedException>(() => f.Service.PdfAsync(f.Principal(),
+            f.Rx.Id.Value, new() { Phone = Fixture.Phone }, default));
+        Assert.Equal(AuditOutcome.Denied, Assert.Single(f.Audit).Outcome);
+    }
+
+    [Fact]
+    public async Task List_calls_only_prescription_contributor_and_filters_cancelled_entries()
+    {
+        var f = new Fixture();
+        var result = JsonSerializer.SerializeToElement(await f.Service.ListAsync(f.Principal(), f.Patient.Id.Value,
+            new() { Phone = Fixture.Phone }, default), JsonSerializerOptions.Web);
+        Assert.Equal(1, result.GetProperty("prescriptionIds").GetArrayLength());
+        Assert.Equal(f.Rx.Id.Value, result.GetProperty("prescriptionIds")[0].GetGuid());
+        Assert.Equal(1, f.TimelineReads);
+        Assert.Equal(AuditOutcome.Allowed, Assert.Single(f.Audit).Outcome);
+    }
+
+    public sealed class Fixture
+    {
+        public const string Phone = "+50370000001";
+        private static readonly Guid ServiceSubject = Guid.Parse("99999999-9999-4999-8999-999999999999");
+        public string Prefix => $"ReceptionDelivery:Tenants:{SyntheticCast.ClinicaSanRafael.Value:D}:";
+        public IConfiguration Configuration { get; }
+        public PatientAggregate Patient { get; }
+        public Prescription Rx { get; set; } = SyntheticPrescriptions.Signed();
+        public List<AuditEntry> Audit { get; } = [];
+        public int OwnershipReads { get; private set; }
+        public int RenderCalls { get; private set; }
+        public bool OwnerMissing { get; init; }
+        public bool ProfileMissing { get; init; }
+        public int PatientReads { get; private set; }
+        public int PrescriptionReads { get; private set; }
+        public int TimelineReads { get; private set; }
+        public bool ForeignPrescriptionOwner { get; init; }
+        public bool PatientMissing { get; init; }
+        public bool AuditFails { get; init; }
+        public bool LicenseRejected { get; init; }
+        public ReceptionDeliveryService Service { get; }
+
+        public Fixture()
+        {
+            Configuration = new ConfigurationBuilder().AddInMemoryCollection(new Dictionary<string, string?>
+            {
+                [Prefix + "Enabled"] = "true", [Prefix + "ClientId"] = "reception-synthetic",
+                [Prefix + "ServiceAccountSubject"] = ServiceSubject.ToString()
+            }).Build();
+            Patient = PatientAggregate.Register(SyntheticCast.ElenaMarroquin, SyntheticCast.ClinicaSanRafael,
+                PatientName.Create("Paciente", "Sintético"), new DateOnly(1990, 1, 1), Sex.Female,
+                new DateOnly(2026, 10, 2), SyntheticCast.CardozaAuthoring(),
+                [EmergencyContact.Create("Contacto Sintético", "Otro", "+50370000009")]);
+            Patient.SetOwnContactInfo(Phone, null);
+            var patientRepo = Stub<IPatientRepository>((method, _) =>
+            {
+                if (method != "FindAsync") throw new InvalidOperationException(method);
+                PatientReads++;
+                return Task.FromResult(PatientMissing ? null : Patient);
+            });
+            var rxRepo = Stub<IPrescriptionRepository>((method, _) =>
+            {
+                if (method == "FindPatientIdAsync")
+                {
+                    OwnershipReads++;
+                    return Task.FromResult<PatientId?>(OwnerMissing ? null :
+                        ForeignPrescriptionOwner ? SyntheticCast.DorisZaldivar : Patient.Id);
+                }
+                if (method != "FindAsync") throw new InvalidOperationException(method);
+                PrescriptionReads++;
+                return Task.FromResult<Prescription?>(Rx);
+            });
+            var rxTimeline = Stub<ITimelineContributor>((method, _) =>
+            {
+                if (method == "get_Produces") return TimelineEntryType.Prescription;
+                TimelineReads++;
+                var entries = new[] { TimelineEntryState.Signed, TimelineEntryState.Cancelled }.Select(state =>
+                    TimelineEntry.ForScope(TimelineVisibilityScope.Clinical, Rx.Id.Value,
+                        TimelineEntryType.Prescription, SyntheticPrescriptions.SignedAt, SyntheticPrescriptions.SignedAt,
+                        new DateOnly(2026, 3, 1), TimelineDiscipline.Medicine, null, null, state,
+                        TimelineSummaryKey.Prescription, [], new TimelineSourceRef(TimelineEntryType.Prescription, Rx.Id.Value), null))
+                    .ToList();
+                return Task.FromResult(new TimelineContributionPage(entries, null));
+            });
+            var noteTimeline = Stub<ITimelineContributor>((method, _) => method == "get_Produces"
+                ? TimelineEntryType.Note : throw new InvalidOperationException("Clinical note must not be read."));
+            Service = new ReceptionDeliveryService(Configuration,
+                Stub<ITenantContext>((_, _) => SyntheticCast.ClinicaSanRafael),
+                Stub<IClock>((_, _) => SyntheticPrescriptions.SignedAt), patientRepo, rxRepo,
+                [rxTimeline, noteTimeline], Stub<IProfessionalProfileReader>((_, _) =>
+                    Task.FromResult<SignerPrintProfile?>(ProfileMissing ? null : new("Hospital Sintético", "Doctora Sintética", null, null))),
+                Stub<ILicenseValidationPolicy>((_, _) => new LicenseValidationResult(!LicenseRejected)),
+                Stub<IClinicCalendar>((_, _) => Task.FromResult(TimeZoneInfo.Utc)),
+                Stub<IPdfRenderer>((_, args) =>
+                {
+                    RenderCalls++;
+                    ((Stream)args![3]!).Write(System.Text.Encoding.ASCII.GetBytes("%PDF-synthetic"));
+                    return Task.CompletedTask;
+                }), Stub<IAuditSink>((_, args) =>
+                {
+                    if (AuditFails) throw new IOException("Synthetic sink unavailable.");
+                    Audit.Add((AuditEntry)args![0]!);
+                    return Task.CompletedTask;
+                }), Stub<ICallerOriginContext>((method, _) => method == "get_RequestId" ? Guid.NewGuid() : null));
+        }
+
+        public async Task<object> Read() => await Service.ReadAsync(Principal(), Rx.Id.Value,
+            new ReceptionDeliveryRequest { Phone = Phone }, default);
+
+        public ClaimsPrincipal Principal(string variant = "") => new(new ClaimsIdentity([
+            new("sub", variant == "wrong-subject" ? Guid.NewGuid().ToString() : ServiceSubject.ToString()),
+            new("tenant_id", variant == "wrong-tenant" ? Guid.NewGuid().ToString() : SyntheticCast.ClinicaSanRafael.Value.ToString()),
+            new("azp", variant == "wrong-client" ? "different-client" : "reception-synthetic"),
+            new("realm_access", variant == "missing-role" ? "{}" : variant == "malformed-role" ? "{" : variant == "nonobject-role" ? "[]" : "{\"roles\":[\"reception-agent\"]}")
+        ], variant == "anonymous" ? null : "synthetic"));
+    }
+
+    private static T Stub<T>(Func<string, object?[]?, object?>? invoke = null) where T : class
+    {
+        var proxy = DispatchProxy.Create<T, ContractStub>();
+        ((ContractStub)(object)proxy).Handler = invoke ?? ((method, _) => throw new InvalidOperationException($"Unexpected call: {method}"));
+        return proxy;
+    }
+
+    public class ContractStub : DispatchProxy
+    {
+        public Func<string, object?[]?, object?> Handler { get; set; } = null!;
+        protected override object? Invoke(MethodInfo? targetMethod, object?[]? args) => Handler(targetMethod!.Name, args);
+    }
+}
