+/// <summary>The canonical prescription sheet composition shared by clinician print jobs and
+/// explicitly authorized delivery. Caller authorization, ownership and export audit remain
+/// with each entry point; frozen licence, signer profile and legal document mapping stay here.</summary>
+public static class PrescriptionPrintJob
+{
+    public static async Task<Result<PrintableDocument>> ComposeAsync(Prescription prescription,
+        string patientDisplayName, DateOnly patientBirthDate, IProfessionalProfileReader profiles,
+        ILicenseValidationPolicy licensePolicy, TimeZoneInfo clinicTimeZone, CancellationToken ct)
+    {
+        if (prescription.Signer is not { } signer)
+            return Error.Validation("clinical_record.prescription.not_signed");
+        if (!string.IsNullOrWhiteSpace(signer.LicenseAtTime)
+            && !licensePolicy.Validate(signer.LicenseAtTime).IsAccepted)
+            return Error.Validation("clinical_record.print_job.license_rejected");
+        var profile = await profiles.GetPrintProfileAsync(signer.ActorId, ct);
+        if (profile is null) return Error.Conflict("clinical_record.print_job.profile_unavailable");
+        try
+        {
+            return PrescriptionPrintMapper.ToPrintableDocument(prescription,
+                patientDisplayName, patientBirthDate, profile, clinicTimeZone, PrintCatalogue.Culture);
+        }
+        catch (ClinicalRecordRuleViolation)
+        {
+            return Error.Validation("clinical_record.print_job.voided_not_printable");
+        }
+    }
+}
