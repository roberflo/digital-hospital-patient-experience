@@ -0,0 +1,40 @@
+using System.Security.Claims;
+
+namespace Hospital.Application.Abstractions.Reception;
+
+/// <summary>Published boundary for the dedicated service capability. Its implementation
+/// authenticates the service, recipient and artifact and audits before returning content.</summary>
+public interface IReceptionDeliveryService
+{
+    Task<ReceptionPrescriptionPage> ListAsync(ClaimsPrincipal caller, Guid patientId, ReceptionDeliveryRequest request, CancellationToken ct);
+    Task<ReceptionPrescriptionDetail> ReadAsync(ClaimsPrincipal caller, Guid prescriptionId, ReceptionDeliveryRequest request, CancellationToken ct);
+    Task<byte[]> PdfAsync(ClaimsPrincipal caller, Guid prescriptionId, ReceptionDeliveryRequest request, CancellationToken ct);
+}
+
+public sealed record ReceptionPrescriptionPage(IReadOnlyList<Guid> PrescriptionIds, string? NextCursor);
+
+public sealed record ReceptionPrescriptionDetail(Guid PrescriptionId, Guid PatientId, Guid EncounterId,
+    string State, DateTimeOffset SignedAt, bool ContentWithheld, IReadOnlyList<ReceptionMedicationLine> Lines)
+{
+    public override string ToString() => nameof(ReceptionPrescriptionDetail);
+}
+
+public sealed record ReceptionMedicationLine(string DrugName, decimal? StrengthAmount, string? StrengthUnit,
+    decimal DoseAmount, string DoseUnit, string Route, int? IntervalHours, bool IsSingleDose,
+    string? Condition, int? DurationDays, bool IsIndefinite, string? Indication,
+    string? SpecialInstructions, decimal? QuantityToDispense)
+{
+    public override string ToString() => nameof(ReceptionMedicationLine);
+}
+
+public sealed class ReceptionDeliveryRequest
+{
+    public string Phone { get; init; } = "";
+    public string? Cursor { get; init; }
+    public override string ToString() => nameof(ReceptionDeliveryRequest);
+}
+
+public sealed class ReceptionDeliveryDeniedException : Exception
+{
+    public ReceptionDeliveryDeniedException() : base("reception.delivery.unavailable") { }
+}
