+using Asp.Versioning;
+using Hospital.Application.Abstractions.Reception;
+using Hospital.Http.Abstractions;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Mvc;
+
+namespace Hospital.ClinicalRecord.Endpoints;
+
+[ApiVersion("1.0")]
+[RequestSizeLimit(8192)]
+[Route("v{version:apiVersion}/reception")]
+public sealed class ReceptionDeliveryController(IReceptionDeliveryService delivery) : ApiControllerBase
+{
+    [HttpPost("patients/{patientId:guid}/prescriptions/list")]
+    [ProducesResponseType<ReceptionPrescriptionPage>(StatusCodes.Status200OK)]
+    [ProducesResponseType<ProblemDetails>(StatusCodes.Status404NotFound)]
+    public async Task<IActionResult> List(Guid patientId, [FromBody] ReceptionDeliveryRequest request,
+        CancellationToken cancellationToken)
+    {
+        Response.Headers.CacheControl = "no-store";
+        return await Execute(async () => Ok(await delivery.ListAsync(User, patientId, request, cancellationToken)));
+    }
+
+    [HttpPost("prescriptions/{prescriptionId:guid}")]
+    [ProducesResponseType<ReceptionPrescriptionDetail>(StatusCodes.Status200OK)]
+    [ProducesResponseType<ProblemDetails>(StatusCodes.Status404NotFound)]
+    public async Task<IActionResult> Read(Guid prescriptionId,
+        [FromBody] ReceptionDeliveryRequest request, CancellationToken cancellationToken)
+    {
+        Response.Headers.CacheControl = "no-store";
+        return await Execute(async () => Ok(await delivery.ReadAsync(User, prescriptionId, request, cancellationToken)));
+    }
+
+    [HttpPost("prescriptions/{prescriptionId:guid}/pdf")]
+    [Produces("application/pdf")]
+    [ProducesResponseType(StatusCodes.Status200OK)]
+    [ProducesResponseType<ProblemDetails>(StatusCodes.Status404NotFound)]
+    public async Task<IActionResult> Pdf(Guid prescriptionId,
+        [FromBody] ReceptionDeliveryRequest request, CancellationToken cancellationToken)
+    {
+        Response.Headers.CacheControl = "no-store";
+        return await Execute(async () => File(
+            await delivery.PdfAsync(User, prescriptionId, request, cancellationToken), "application/pdf"));
+    }
+
+    private async Task<IActionResult> Execute(Func<Task<IActionResult>> action)
+    {
+        try { return await action(); }
+        catch (ReceptionDeliveryDeniedException)
+        {
+            var problem = new ProblemDetails { Status = StatusCodes.Status404NotFound, Title = "Not Found" };
+            problem.Extensions["code"] = "reception.delivery.unavailable";
+            return NotFound(problem);
+        }
+    }
+}
