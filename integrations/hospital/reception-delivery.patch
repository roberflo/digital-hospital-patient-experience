+using System.Security.Claims;
+using System.Security.Cryptography;
+using System.Text.Json;
+using Hospital.Application.Abstractions;
+using Hospital.Application.Abstractions.Reception;
+using Hospital.Application.Abstractions.Auditing;
+using Hospital.Application.Abstractions.Clinic;
+using Hospital.Application.Abstractions.Documents;
+using Hospital.Application.Abstractions.Legal;
+using Hospital.Application.Abstractions.Timeline;
+using Hospital.ClinicalRecord.Application.Ports;
+using Hospital.ClinicalRecord.Application.Commands;
+using Hospital.ClinicalRecord.Application.Printing;
+using Hospital.ClinicalRecord.Domain;
+using Hospital.Patient.Application.Ports;
+using Hospital.SharedKernel;
+
+namespace Hospital.Api.Reception;
+
+/// <summary>Dedicated service capability at the composition boundary. It does not call,
+/// replace or widen the ordinary clinician authorization policy. All its entry points
+/// verify the configured caller and recipient and await an append-only export audit.</summary>
+public sealed class ReceptionDeliveryService(
+    IConfiguration configuration, ITenantContext tenant, IClock clock, IPatientRepository patients,
+    IPrescriptionRepository prescriptions, IEnumerable<ITimelineContributor> contributors,
+    IProfessionalProfileReader profiles, ILicenseValidationPolicy licensePolicy,
+    IClinicCalendar calendar, IPdfRenderer renderer, IAuditSink audit, ICallerOriginContext origin) : IReceptionDeliveryService
+{
+    private const string Resource = "reception-prescription-delivery";
+
+    public async Task<ReceptionPrescriptionPage> ListAsync(ClaimsPrincipal caller, Guid patientId,
+        ReceptionDeliveryRequest request, CancellationToken ct)
+    {
+        await VerifyAsync(caller, patientId, null, request.Phone, ct);
+        if (request.Cursor?.Length > 2048) await RejectAsync(caller, patientId, null, ct);
+        TimelineCursor? cursor = null;
+        try
+        {
+            if (request.Cursor is { Length: > 0 })
+                cursor = JsonSerializer.Deserialize<TimelineCursor>(Convert.FromBase64String(request.Cursor));
+        }
+        catch (Exception e) when (e is FormatException or JsonException)
+        {
+            await RejectAsync(caller, patientId, null, ct);
+        }
+        var page = await contributors.Single(x => x.Produces == TimelineEntryType.Prescription)
+            .GetPageAsync(new PatientId(patientId), TimelineVisibilityScope.Clinical, cursor, 50, null, ct);
+        var ids = page.Entries.Where(x => x.State == TimelineEntryState.Signed)
+            .Select(x => x.EntryId).ToArray();
+        await RecordAsync(caller, patientId, null, AuditOutcome.Allowed, null, ct);
+        return new ReceptionPrescriptionPage(ids, page.NextCursor is { } next
+            ? Convert.ToBase64String(JsonSerializer.SerializeToUtf8Bytes(next)) : null);
+    }
+
+    public async Task<ReceptionPrescriptionDetail> ReadAsync(ClaimsPrincipal caller, Guid prescriptionId,
+        ReceptionDeliveryRequest request, CancellationToken ct)
+    {
+        var patientId = await ResolvePatientAsync(caller, prescriptionId, ct);
+        await VerifyAsync(caller, patientId, prescriptionId, request.Phone, ct);
+        var rx = await PrescriptionAsync(caller, patientId, prescriptionId, ct);
+        var result = new ReceptionPrescriptionDetail(rx.Id.Value, rx.PatientId.Value, rx.EncounterId.Value,
+            "signed", rx.Signer!.At, false, rx.Lines.Select(line => new ReceptionMedicationLine(
+                line.DrugName, line.Strength?.Amount, line.Strength?.Unit.Code,
+                line.Dose.Amount, line.Dose.Unit.Code, line.Route.Code,
+                line.Frequency.IsSingleDose ? (int?)null : line.Frequency.IntervalHours,
+                line.Frequency.IsSingleDose, line.Frequency.Condition?.Text, line.Duration?.Days,
+                line.Duration?.IsIndefinite ?? false, line.Indication, line.SpecialInstructions,
+                line.QuantityToDispense)).ToArray());
+        var hash = Convert.ToHexString(SHA256.HashData(JsonSerializer.SerializeToUtf8Bytes(result, JsonSerializerOptions.Web))).ToLowerInvariant();
+        await RecordAsync(caller, patientId, prescriptionId, AuditOutcome.Allowed, hash, ct);
+        return result;
+    }
+
+    public async Task<byte[]> PdfAsync(ClaimsPrincipal caller, Guid prescriptionId,
+        ReceptionDeliveryRequest request, CancellationToken ct)
+    {
+        var patientId = await ResolvePatientAsync(caller, prescriptionId, ct);
+        var patient = await VerifyAsync(caller, patientId, prescriptionId, request.Phone, ct);
+        var rx = await PrescriptionAsync(caller, patientId, prescriptionId, ct);
+        var signer = rx.Signer!;
+        var composition = await PrescriptionPrintJob.ComposeAsync(rx,
+            $"{patient.Name.GivenNames} {patient.Name.FamilyNames}", patient.BirthDate, profiles, licensePolicy,
+            await calendar.ResolveTimeZoneAsync(ct), ct);
+        if (!composition.IsSuccess) await RejectAsync(caller, patientId, prescriptionId, ct);
+        using var output = new MemoryStream();
+        await renderer.RenderAsync(composition.Value, signer.At, PrintCatalogue.Culture, output, ct);
+        var bytes = output.ToArray();
+        var hash = Convert.ToHexString(SHA256.HashData(bytes)).ToLowerInvariant();
+        await RecordAsync(caller, patientId, prescriptionId, AuditOutcome.Allowed, hash, ct);
+        return bytes;
+    }
+
+    private async Task<Guid> ResolvePatientAsync(ClaimsPrincipal caller, Guid prescriptionId, CancellationToken ct)
+    {
+        // No ownership lookup until the dedicated service capability has been authenticated.
+        await VerifyCallerAsync(caller, null, prescriptionId, ct);
+        var owner = await prescriptions.FindPatientIdAsync(new PrescriptionId(prescriptionId), ct);
+        if (owner is null || owner.Value.Value == Guid.Empty) await RejectAsync(caller, null, prescriptionId, ct);
+        return owner!.Value.Value;
+    }
+
+    private async Task VerifyCallerAsync(ClaimsPrincipal caller, Guid? patientId, Guid? prescriptionId, CancellationToken ct)
+    {
+        var clientId = caller.FindFirst("azp")?.Value;
+        var expected = configuration[$"ReceptionDelivery:Tenants:{tenant.TenantId.Value:D}:ClientId"];
+        var expectedSubject = configuration[$"ReceptionDelivery:Tenants:{tenant.TenantId.Value:D}:ServiceAccountSubject"];
+        var enabled = configuration.GetValue<bool>($"ReceptionDelivery:Tenants:{tenant.TenantId.Value:D}:Enabled");
+        var roles = caller.FindFirst("realm_access")?.Value;
+        var hasRole = false;
+        try
+        {
+            using var doc = JsonDocument.Parse(roles ?? "{}");
+            hasRole = doc.RootElement.ValueKind == JsonValueKind.Object && doc.RootElement.TryGetProperty("roles", out var values) && values.ValueKind == JsonValueKind.Array
+                && values.EnumerateArray().Any(x => x.ValueKind == JsonValueKind.String && x.GetString() == "reception-agent");
+        }
+        catch (JsonException) { /* Invalid roles fail closed. */ }
+        if (caller.Identity?.IsAuthenticated != true || !enabled || !hasRole || string.IsNullOrWhiteSpace(expected)
+            || clientId != expected || !Guid.TryParse(caller.FindFirst("tenant_id")?.Value, out var claimTenant)
+            || !Guid.TryParse(expectedSubject, out var allowedSubject) || allowedSubject == Guid.Empty
+            || !Guid.TryParse(caller.FindFirst("sub")?.Value, out var actualSubject) || actualSubject != allowedSubject
+            || claimTenant != tenant.TenantId.Value)
+            await RejectAsync(caller, patientId, prescriptionId, ct);
+    }
+
+    private async Task<Hospital.Patient.Domain.Patient> VerifyAsync(ClaimsPrincipal caller, Guid patientId,
+        Guid? prescriptionId, string phone, CancellationToken ct)
+    {
+        await VerifyCallerAsync(caller, patientId, prescriptionId, ct);
+        if (patientId == Guid.Empty) await RejectAsync(caller, null, prescriptionId, ct);
+        var patient = await patients.FindAsync(new PatientId(patientId), ct);
+        var normalized = Phone(phone);
+        if (patient is null || patient.TenantId != tenant.TenantId || patient.Id.Value != patientId
+            || patient.RecordState is not null || normalized is null || Phone(patient.Phone) != normalized)
+            await RejectAsync(caller, patientId, prescriptionId, ct);
+        return patient!;
+    }
+
+    private async Task<Prescription> PrescriptionAsync(ClaimsPrincipal caller, Guid patientId,
+        Guid prescriptionId, CancellationToken ct)
+    {
+        // Narrow ownership lookup before decrypting a prescription belonging to another person.
+        var owner = await prescriptions.FindPatientIdAsync(new PrescriptionId(prescriptionId), ct);
+        if (owner?.Value != patientId) await RejectAsync(caller, patientId, prescriptionId, ct);
+        var rx = await prescriptions.FindAsync(new PrescriptionId(prescriptionId), ct);
+        if (rx is null || rx.TenantId != tenant.TenantId || rx.Id.Value != prescriptionId
+            || rx.PatientId.Value != patientId || rx.State != PrescriptionState.Signed || rx.Signer is null)
+            await RejectAsync(caller, patientId, prescriptionId, ct);
+        return rx!;
+    }
+
+    private async Task RejectAsync(ClaimsPrincipal caller, Guid? patientId, Guid? prescriptionId, CancellationToken ct)
+    {
+        await RecordAsync(caller, patientId, prescriptionId, AuditOutcome.Denied, null, ct);
+        throw new ReceptionDeliveryDeniedException();
+    }
+
+    private Task RecordAsync(ClaimsPrincipal caller, Guid? patientId, Guid? prescriptionId,
+        AuditOutcome outcome, string? hash, CancellationToken ct) => audit.AppendAsync(new AuditEntry(
+            tenant.TenantId, clock.UtcNow, patientId is { } knownPatient
+                ? new AuditSubject.Patient(new PatientId(knownPatient))
+                : new AuditSubject.None(Resource),
+            Actor(caller),
+            Resource, prescriptionId, AuditAction.Export, outcome, AccessBasis.Routine, origin.RequestId,
+            OriginIp: origin.OriginIp, OriginAgent: origin.OriginAgent,
+            OriginChannel: "whatsapp", AccessReason: "patient-linked-phone",
+            ExportedContentSha256: hash), ct);
+
+    private AuditActor Actor(ClaimsPrincipal caller)
+    {
+        var expected = configuration[$"ReceptionDelivery:Tenants:{tenant.TenantId.Value:D}:ServiceAccountSubject"];
+        if (Guid.TryParse(expected, out var serviceSubject) &&
+            Guid.TryParse(caller.FindFirst("sub")?.Value, out var subject) && subject == serviceSubject)
+            return new AuditActor.Service("reception-agent:" + caller.FindFirst("azp")?.Value);
+        if (Guid.TryParse(caller.FindFirst("sub")?.Value, out var user))
+            return new AuditActor.User(new ActorId(user), ClinicalRoleCatalog.NoRecognizedProductRoleAuditLabel);
+        return new AuditActor.Anonymous();
+    }
+
+    private static string? Phone(string? value)
+    {
+        if (string.IsNullOrWhiteSpace(value)) return null;
+        var digits = new string(value.Where(c => c is >= '0' and <= '9').ToArray());
+        return digits.Length is >= 8 and <= 15 && digits[0] != '0' ? digits : null;
+    }
+}
